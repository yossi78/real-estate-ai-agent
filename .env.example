# Shared orchestration defaults. Copy to .env before `docker compose up`.

NODE_ENV=production
BACKEND_PORT=3001
FRONTEND_PORT=5173

# Redis
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=86400

# Ollama (local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_CONCURRENCY=2

# Rate limiting — tune for 10K vs 100K req/day (see README)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Node cluster workers (0 = os.cpus().length)
CLUSTER_WORKERS=0
